# Server
PORT=8080
LOG_LEVEL=info

# LLM (any OpenAI-compatible endpoint). Default is Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional providers. Leave empty to skip that provider.
TICKETMASTER_API_KEY=
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=

# Behaviour
PROVIDER_TIMEOUT=8s
CACHE_TTL=10m
VENUE_RADIUS_M=5000
EVENT_RADIUS_KM=30
